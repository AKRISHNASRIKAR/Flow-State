DATABASE_URL="postgresql://flowforge:flowforge@localhost:5432/flowforge?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
PORT=3000

# Comma-separated origins allowed to call the API from a browser.
# Defaults to the local Vite dev server (frontend/).
CORS_ORIGIN=http://localhost:5173

# Execution engine (Phase 3)
WORKER_CONCURRENCY=5

# Notification action executors (SEND_EMAIL, TELEGRAM_NOTIFY) — optional.
# Executors return a clear error if the workflow uses them without these set.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=  # e.g. noreply@yourdomain.com (must be a verified Resend sender)
TELEGRAM_BOT_TOKEN=

# Google sign-in — the only way to sign in. Without these the API still
# starts, but /auth/google/start returns 503.
# Create a *Web application* OAuth client in Google Cloud Console and add
# GOOGLE_REDIRECT_URI to its Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Encrypts stored Google tokens (AES-256-GCM). 32 bytes, base64:
#   openssl rand -base64 32
# Changing it later makes every stored Google token unreadable.
CREDENTIALS_ENCRYPTION_KEY=
# Where the API sends the browser after sign-in.
FRONTEND_URL=http://localhost:5173

# Admin/DLQ endpoints (GET/POST /admin/failed-jobs) — required to use them.
# Send as the X-Admin-Secret header. Leave unset to disable admin routes.
ADMIN_SECRET=
