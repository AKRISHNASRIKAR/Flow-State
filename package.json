{
  "name": "flowstate-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FlowState - workflow automation platform (NestJS API + React dashboard)",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "turbo run typecheck",
    "check": "pnpm --filter api prisma:generate && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "audit:deps": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  }
}
